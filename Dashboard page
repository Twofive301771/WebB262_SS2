@page "/dashboard"
@rendermode InteractiveServer
@inject ListingService listingService

<h3>My Dashboard</h3>

<h4>My Listings</h4>
@if (listingService.Listings.Count == 0)
{
    <p>No listings yet.</p>
}
else
{
    @foreach (var listing in listingService.Listings)
    {
        <div style="border:1px solid black; padding:10px; margin:10px;">
            <p><strong>Title:</strong> @listing.Title</p>
            <p><strong>Price:</strong> R @listing.Price</p>
            <p><strong>Condition:</strong> @listing.Condition</p>
        </div>
    }
}

<hr />

<h4>My Offers</h4>
@if (listingService.Offers.Count == 0)
{
    <p>No offers yet.</p>
}
else
{
    @foreach (var offer in listingService.Offers)
    {
        <div style="border:1px solid black; padding:10px; margin:10px;">
            <p><strong>Listing:</strong> @offer.ListingTitle</p>
            <p><strong>Offer:</strong> R @offer.OfferAmount</p>
            <p><strong>Status:</strong> @offer.Status</p>
        </div>
    }
}

<hr />

<h4>My Transactions</h4>
@if (listingService.Transactions.Count == 0)
{
    <p>No transactions yet.</p>
}
else
{
    @foreach (var transaction in listingService.Transactions)
    {
        <div style="border:1px solid black; padding:10px; margin:10px;">
            <p><strong>Listing:</strong> @transaction.ListingTitle</p>
            <p><strong>Final Price:</strong> R @transaction.FinalPrice</p>
            <p><strong>Status:</strong> @transaction.Status</p>
        </div>
    }
}

<hr />

<h4>My Reviews</h4>
<p>No reviews yet.</p>
